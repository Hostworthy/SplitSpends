# Copy to deploy/.env and fill in. See docs/ENVIRONMENT.md for every option.

POSTGRES_PASSWORD=change-me
# Public URL people use to reach the app (used in emails).
BASE_URL=https://split.example.com
# 64 hex characters: openssl rand -hex 32
SECRET_KEY=

# open | invite | domain. "invite" lets in the first account plus anyone an
# existing user adds as a friend or group member.
SIGNUP_MODE=invite
# SIGNUP_ALLOWED_DOMAINS=example.com

# Email (login codes and notifications). Gmail needs an app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=
SMTP_FROM=Split Spends <you@gmail.com>

# Optional AI receipt scanning: anthropic | openai | none
AI_PROVIDER=none
# AI_API_KEY=
# AI_MODEL=
# For AI_PROVIDER=openai (Ollama, vLLM, OpenRouter, LiteLLM...):
# AI_BASE_URL=http://ollama:11434/v1

# Number of reverse proxies in front of the server that append the client
# address to X-Forwarded-For (true means 1). Leave false when the server is
# reached directly. See docs/ENVIRONMENT.md.
TRUST_PROXY=false
