# Automatic HTTPS in front of Split Spends. Point your domain's DNS at this
# machine and open ports 80 and 443. For a LAN-only setup, see docs/HOSTING.md.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8080
	# ">" replaces the header the app sends, adding includeSubDomains.
	header {
		>Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
