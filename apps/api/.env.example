# Local development settings for `make api`, copied to apps/api/.env by
# `make setup`. Development only: open sign-up, any CORS origin and debug logs
# suit a laptop, not a server. For a server start from deploy/.env.example and
# docs/ENVIRONMENT.md.
DATABASE_URL=postgres://splitspends:splitspends@localhost:5432/splitspends?sslmode=disable
# 64 hex characters: openssl rand -hex 32. `make setup` fills in a random one.
SECRET_KEY=
BASE_URL=http://localhost:8080
# Development only: anyone can sign up.
SIGNUP_MODE=open
# Only this address can create the first account (the administrator).
# ADMIN_EMAIL=you@example.com
# Development only: any origin may call the API. On a server leave it empty
# or list the origins that need it.
CORS_ORIGINS=*
LOG_FORMAT=text
LOG_LEVEL=debug
DATA_DIR=./data
# Leave SMTP_HOST empty to print login codes in the server log.
SMTP_HOST=
AI_PROVIDER=none
# Offer the admin_ tools to assistants on /mcp.
# MCP_ADMIN_TOOLS=false
