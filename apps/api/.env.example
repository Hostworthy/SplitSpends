# Local development settings for `make api`. Copied to backend/.env by `make setup`.
DATABASE_URL=postgres://splitspends:splitspends@localhost:5432/splitspends?sslmode=disable
SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdef
BASE_URL=http://localhost:8080
SIGNUP_MODE=open
# Only this address can create the first account (the administrator).
# ADMIN_EMAIL=you@example.com
CORS_ORIGINS=*
LOG_FORMAT=text
LOG_LEVEL=debug
DATA_DIR=./data
# Leave SMTP_HOST empty to print login codes in the server log.
SMTP_HOST=
AI_PROVIDER=none
