<?xml version="1.0" encoding="utf-8"?>
<!-- These rules govern Android's own networking (the platform HTTP stack and
     web views). The app talks to its server through Dart's HTTP client, which
     opens its own connections and follows neither rule below: the app itself
     warns about http:// addresses and asks before using one outside the local
     network, and Dart trusts only the system certificate authorities, not
     ones installed on the phone. Plain HTTP and user certificates stay
     allowed here so links opened in a web view behave as in the browser. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
